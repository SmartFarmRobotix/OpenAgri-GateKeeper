# GateKeeper environment example
# Copy to .env and adjust values; the service refuses to start while DJANGO_SECRET_KEY or JWT_SIGNING_KEY is
# still "change-me". Set the database and superuser passwords as well.

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8001
EXTRA_ALLOWED_HOSTS=localhost,127.0.0.1

# JWT
JWT_SIGNING_KEY=change-me
JWT_ALG=HS256
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# DEPLOYMENT_PROFILE: "hardened" (default) rejects the
# admin/admin default-credential login pair; only "demo" allows it.
DEPLOYMENT_PROFILE=hardened

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gatekeeper
DB_USER=gatekeeper_admin
DB_PASS=change-me

# MySQL container env (used by compose)
MYSQL_DATABASE=gatekeeper
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=gatekeeper_admin
MYSQL_PASSWORD=change-me

# Superuser bootstrap (used by initial_setup)
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me

# Optional service URLs (legacy/static registration)
FARM_CALENDAR_API=http://127.0.0.1:8002/api/
FARM_CALENDAR_POST_AUTH=http://127.0.0.1:8002/post_auth/
IRM_API=http://127.0.0.1:5173/api/
IRM_POST_AUTH=http://127.0.0.1:5173/post_auth/

# Internal GK URL (used by some internal calls)
INTERNAL_GK_URL=http://gatekeeper:8001/

# Anonymous-endpoint (e.g. /api/login/) throttle rate override, DRF format
# (e.g. "100000/hour"). Leave unset to keep the out-of-box default defined
# in gatekeeper/settings.py (100/hour). Raise this for development stacks
# that make heavy anonymous call volume (repeated smoke-test logins).
# GK_ANON_THROTTLE_RATE=100000/hour
